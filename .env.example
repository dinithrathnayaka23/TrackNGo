# Database Configuration
# Local dev (no SSL):
DB_URL=jdbc:mysql://localhost:3306/trackngo?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# Aiven (or any TLS-required MySQL) — sslMode=REQUIRED instead of useSSL=false:
# DB_URL=jdbc:mysql://<aiven-host>:<aiven-port>/<database>?sslMode=REQUIRED&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_db_password

# Hibernate schema check. Defaults to "validate" (the production database's
# schema is managed by hand-written migrations, not Hibernate). Only set this
# to "update" locally if you need Hibernate to patch a fresh/older local DB.
JPA_DDL_AUTO=validate

# JWT Configuration
JWT_SECRET=your-jwt-secret-at-least-32-characters-long

# CORS / WebSocket allowed origin(s) for browser clients (the admin dashboard).
# Comma-separate if you need more than one (e.g. a Vercel preview URL).
# Leave unset for local dev — defaults to the admin dashboard's Vite dev server.
# Native mobile clients are unaffected either way (they don't send an Origin header).
FRONTEND_URL=https://your-admin-dashboard.vercel.app

# Render provides this automatically in production — leave unset locally
# (falls back to 8080).
PORT=

# API Keys
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Google Sign-In — not currently wired to any endpoint; leave unset.
GOOGLE_CLIENT_ID=

# Twilio SMS
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number
TWILIO_MESSAGING_SERVICE_SID=your_twilio_messaging_service_sid
TWILIO_DEFAULT_COUNTRY_CODE=+94

# SMS Provider (twilio or android-gateway)
SMS_PROVIDER=twilio
SMS_ANDROID_GATEWAY_URL=
SMS_ANDROID_GATEWAY_API_KEY=

# Mail (used by the admin forgot-password OTP flow via JavaMailSender).
# Leave blank in local dev: the app still boots, and the OTP code is logged
# to the console instead of being emailed (search logs for "[DEV OTP]").
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@trackngo.local

# Note: the admin forgot-password OTP flow can also deliver via SMS, reusing
# the same TWILIO_* credentials configured above. If Twilio isn't configured,
# it likewise falls back to logging the OTP code to the console.

# Stripe (Test Mode)
# Get your keys from https://dashboard.stripe.com/test/apikeys
# Required — the app fails fast at startup if these are unset.
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# PayHere (optional second payment gateway; sandbox by default)
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_SANDBOX=true

# AI Integration (OpenAI-compatible providers)
# llama-3.1-8b-instant is deprecated on Groq (404s) — use one of the models
# below instead.
AI_API_KEY=your_ai_provider_api_key_here
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-20b
AI_FALLBACK_MODEL=openai/gpt-oss-120b
AI_MODEL_TIMEOUT_SECONDS=12
AI_MODEL_FUNCTIONS_ENABLED=false
AI_MODEL_DIRECT_HTTP_ENABLED=true

# Gemini AI Integration (legacy fallback env names)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro
GEMINI_FALLBACK_MODEL=gemini-1.5-flash

# Common alternatives:
# Groq:       AI_BASE_URL=https://api.groq.com/openai/v1
# OpenRouter: AI_BASE_URL=https://openrouter.ai/api/v1

