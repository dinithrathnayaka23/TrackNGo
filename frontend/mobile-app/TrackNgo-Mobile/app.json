{
  "expo": {
    "name": "TrackNGo",
    "slug": "trackngo-chat",
    "scheme": "trackngo",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "androidStatusBar": {
      "backgroundColor": "#FFFFFF",
      "barStyle": "dark-content"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.trackngo.passenger",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "config": {}
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "TrackNGo needs your location to share it in chat.",
          "locationWhenInUsePermission": "TrackNGo needs your location to share it in chat."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow TrackNGo to access your photos and videos.",
          "savePhotosPermission": "Allow TrackNGo to save photos and videos.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "db76b00f-e08c-4df8-b05e-36ef278be93b"
      }
    }
  }
}
